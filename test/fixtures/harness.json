{
  "servers": {
    "candidate": "mock-candidate-good.mjs",
    "reference": "mock-reference.mjs"
  },
  "outputDir": "runs",
  "rpcTimeoutMs": 15000,
  "retryCount": 0,
  "replayPolicy": "PERIOD_PAIRED",
  "scenarios": [
    {
      "id": "server-metrics",
      "domain": "server",
      "description": "Server CPU and memory metrics",
      "projectCode": 33194,
      "stime": 1795336800000,
      "etime": 1795338600000,
      "referenceTool": "whatap_http_server_metrics",
      "mcpPath": "v2/sys/server_base",
      "matchKeys": [
        "time",
        "_id_"
      ],
      "compareFields": [
        "cpu",
        "memory_pused"
      ],
      "absoluteTolerance": 0.000001,
      "allowedMcpPaths": [
        "v2/sys/server_base"
      ],
      "expectedDuration": "1h",
      "userRequest": "테스트 프로젝트 33194 최근 1시간 CPU 메모리 조회"
    },
    {
